# npm start loads this optional local file through Node's --env-file-if-exists.
# OAuth requires migration and one offline-created owner; none requires acknowledgment.
AUTH_MODE=oauth
PUBLIC_ORIGIN=https://mcp.example.com
PORT=3000
MCP_LEGACY_MODE=stateless

# Generate once with a cryptographic random generator; retain across restarts.
BETTER_AUTH_SECRET=
# Use a dedicated directory outside allowed roots; protect it with owner-only ACLs.
DATABASE_PATH=./data/auth.sqlite

# Leave empty. A no-auth listener requires an explicit local acknowledgment.
# Public unauthenticated access permits reading and modifying every allowed root.
# Required exact acknowledgment is documented in README.md; this is not consent.
ACK_UNAUTHENTICATED_FILESYSTEM_ACCESS=
