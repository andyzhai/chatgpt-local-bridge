{
  "name": "localbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local filesystem MCP bridge with bounded SDK v2 filesystem tools",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/main.js",
    "auth:migrate": "node --env-file-if-exists=.env dist/auth/admin.js migrate",
    "owner:create": "node --env-file-if-exists=.env dist/auth/admin.js owner",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "better-auth": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.6",
    "diff": "8.0.3",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "24.10.0",
    "@types/better-sqlite3": "9.6.0",
    "vitest": "5.0.3",
    "vite": "8.3.4",
    "@modelcontextprotocol/client": "2.3.1",
    "auth": "1.7.7"
  },
  "license": "MIT"
}
